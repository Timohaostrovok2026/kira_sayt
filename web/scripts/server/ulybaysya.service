[Unit]
Description=Сайт «Улыбайся» (Next.js)
After=network.target

[Service]
User=uly
Group=uly
WorkingDirectory=/opt/ulybaysya/app
EnvironmentFile=/etc/ulybaysya.env
Environment=NODE_ENV=production
# Только локально: наружу сайт отдаёт Caddy.
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
