# Скопируйте в .env.local и заполните.

# Адрес сайта (для ссылок в соцсетях и SEO)
NEXT_PUBLIC_SITE_URL=https://example.ru

# Заявки в Telegram: создайте бота у @BotFather, добавьте его в чат менеджеров,
# узнайте id чата (например, через @getidsbot) и впишите сюда.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пароль от страницы /stats
STATS_PASSWORD=

# Яндекс Метрика (вебвизор и карта кликов). Номер счётчика, например 12345678
NEXT_PUBLIC_YM_ID=

# Где хранить базу заявок и статистики (по умолчанию ./data)
DATA_DIR=
